# ─── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ─── Build output ──────────────────────────────────────────────────────────────
# Generated by: npm run build
# DO NOT commit — Hostinger runs `npm install && npm run build` on deployment.
dist/

# ─── Runtime data ──────────────────────────────────────────────────────────────
# These files are auto-created by the server at startup and contain live
# customer/operational data. Never commit them — they are environment-specific
# and managed outside version control.
runtime/
runtime/*.json

# ─── Uploads ───────────────────────────────────────────────────────────────────
# Multer uploads are stored on the server's filesystem; back them up separately.
uploads/

# ─── Environment variables ─────────────────────────────────────────────────────
# Configure secrets in Hostinger hPanel → Node.js → Environment Variables.
.env
.env.local
.env.*.local

# ─── Logs & local backups (server-only) ───────────────────────────────────────
logs/
backups/

# ─── Replit internals ──────────────────────────────────────────────────────────
.vitecache/
.cache/
.local/
.agents/
.replit
replit.md

# ─── OS clutter ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Misc ──────────────────────────────────────────────────────────────────────
*.opt.tmp
*.sharp-larger
